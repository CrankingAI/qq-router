# qq configuration — copy to .env and fill in, or just export these.
# Names and placeholders only. Never commit a filled-in .env.
#
# Most people do not need this file at all: ./scripts/setup-cli.sh writes a
# config file in your user config directory instead.

# Foundry resource endpoint. The /openai/v1 suffix is added automatically.
QQ_ENDPOINT=https://your-foundry-resource.openai.azure.com

# Name of the model-router deployment created by infra/main.bicep.
QQ_DEPLOYMENT=qq-router

# Authentication mode: auto (default), entra, or key.
# Prefer entra — it needs no secret at all, just `az login`.
QQ_AUTH=entra

# Entra tenant that owns the Foundry resource. Needed when your Azure CLI
# default subscription lives in a different tenant.
QQ_TENANT_ID=

# Only for QQ_AUTH=key. Leave empty to use Microsoft Entra ID.
QQ_API_KEY=

# Optional overrides.
# QQ_MODEL=gpt-5.6-sol
# QQ_TIMEOUT=60

# --- OpenRouter backend (optional) -----------------------------------------
# qq also speaks to OpenRouter, which needs no infrastructure at all.
# Billed by OpenRouter, not against Azure credits.

# Switch backends: azure (default) or openrouter.
QQ_PROVIDER=azure

# From https://openrouter.ai/keys. OPENROUTER_API_KEY is honoured too.
QQ_OPENROUTER_API_KEY=

# Cost tier for openrouter/auto: low, medium, high, xhigh, max.
# QQ_COST_TIER=low

# Restrict what the auto-router may choose. Comma-separated, wildcards allowed.
# QQ_ALLOWED_MODELS=openai/*,anthropic/*
